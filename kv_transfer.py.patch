+    def _record_get_result(
+        self,
+        req_meta: ReqMeta,
+        ret: list[int] | None,
+        block_id_list_c: list[int],
+    ) -> None:
+        """Shared failure-accounting helper for both the normal-group and
+        broadcast-group `get()` paths. Behavior matches the original
+        (pre-broadcast) inline logic exactly."""
+        if ret is not None and any(r != 0 for r in ret):
+            missing_block_ids = record_failed_blocks(block_id_list_c, ret)
+        elif ret is None:
+            missing_block_ids = record_failed_blocks(block_id_list_c, [1] * len(block_id_list_c))
+        else:
+            return
+        if len(req_meta.block_ids_by_group) == 1:
+            with self._invalid_block_ids_lock:
+                self._invalid_block_ids.update(missing_block_ids)
+        elif missing_block_ids:
+            logger.error(
+                "KV load failed for hybrid request %s. "
+                "Skip invalid-block fallback to avoid scheduler crash. "
+                "failed_blocks=%s",
+                req_meta.req_id,
+                missing_block_ids,
+            )
+
+    def _handle_broadcast_group_entries(
+        self,
+        req_meta: ReqMeta,
+        key_list: list[str],
+        addr_list: list[list[int]],
+        size_list: list[list[int]],
+        block_id_list: list[int],
+    ) -> None:
+        """Rank-0-reads + HCCS-broadcasts the TP-replicated-group entries
+        for one request. Falls back to every rank independently calling
+        `m_store.get` (the pre-broadcast behavior) whenever the
+        broadcaster is unavailable, so this can never silently serve wrong
+        data -- only lose the bandwidth benefit."""
+        req_id = req_meta.req_id
+        broadcaster = self._tp_broadcaster
+        ret: list[int] | None = None
+        ok = True
+        if self.tp_rank == 0:
+            logger.debug(
+                "KV pool async recv (TP broadcast root) calls backend get "
+                "request=%s keys=%d sample_keys=%s",
+                req_id,
+                len(key_list),
+                key_list[:3],
+            )
+            ret = self.m_store.get(key_list, addr_list, size_list)
+            ok = ret is not None and all(r == 0 for r in ret)
+
+        broadcast_done = broadcaster is not None and broadcaster.broadcast_nested(addr_list, size_list, src=0)
+        if broadcast_done:
+            ok = broadcaster.broadcast_status(ok, src=0)
+            if self.tp_rank != 0:
+                # Non-root ranks never talked to the remote store, so they
+                # have no per-key ret codes of their own. Conservatively
+                # mark every block in this batch as failed when the
+                # broadcast status says "not ok", rather than guessing
+                # which key(s) actually failed on rank 0.
+                ret = [0] * len(block_id_list) if ok else [1] * len(block_id_list)
+        elif self.tp_rank != 0:
+            logger.warning(
+                "KV pool async recv (TP broadcast unavailable, falling "
+                "back to per-rank get) request=%s keys=%d",
+                req_id,
+                len(key_list),
+            )
+            ret = self.m_store.get(key_list, addr_list, size_list)
+
+        self._record_get_result(req_meta, ret, block_id_list)
+
 
